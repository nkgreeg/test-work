# PostgreSQL host (e.g. `db` or `127.0.0.1`)
DB_HOST=db

# PostgreSQL port (e.g. `5432`)
DB_PORT=5432

# PostgreSQL database name (e.g. `app` or `shop_db`)
DB_NAME=app

# PostgreSQL user (e.g. `app` or `admin`)
DB_USER=app

# PostgreSQL password (e.g. `ChangeMe` or `secure_pass`)
DB_PASSWORD=ChangeMe

# PostgreSQL server version (e.g. `16` or `17`)
DB_VERSION=16

# PostgreSQL image version (e.g. `17` or `16`)
POSTGRES_VERSION=17

# Application port (e.g. `8000` or `8080`)
APP_PORT=8000
